{
  "name": "cappy",
  "version": "0.1.0",
  "description": "Local budget-paced LLM proxy for any provider — spread a prepaid API budget across the month, for OpenAI-compatible providers today (DeepSeek, OpenAI, Groq, and more), with pricing kept fresh via models.dev",
  "engines": { "node": ">=18" },
  "preferGlobal": true,
  "bin": {
    "cappy": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/index.js",
    "dist/types.js",
    "dist/adapters/",
    "dist/proxy/",
    "dist/pacing/",
    "dist/db/",
    "dist/scripts/",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && mkdir -p dist/adapters/pricing && cp src/adapters/pricing/*.json dist/adapters/pricing/",
    "start": "node dist/index.js",
    "sync-pricing": "tsx src/scripts/sync-pricing.ts",
    "test": "node -r tsx/cjs --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.4.1",
    "fastify": "^5.2.1",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
